# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project -> Settings -> Environment Variables.

# Firebase web config (Firebase console -> Project settings -> General -> Your apps -> Web app).
# Use the SAME Firebase project as the Streamlit app so history is shared.
# These identify the project and are public by design; data access is enforced by
# Firebase Auth + the Firestore security rules in firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emotion detection runs entirely in the browser (TensorFlow.js + OpenCV.js); no inference API is needed.

# Local development only: use the Firebase Auth emulator (e.g. 127.0.0.1:9099). Leave empty in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
