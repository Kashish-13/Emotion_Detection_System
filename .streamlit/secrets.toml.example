# Copy this file to .streamlit/secrets.toml and fill in your Firebase project's values.
# secrets.toml is git-ignored — never commit it.
#
# Firebase console → Project settings → General → "Web API Key" and "Project ID".
# (The Web API key identifies the project; access to data is enforced by firestore.rules.)

[firebase]
api_key = "YOUR_FIREBASE_WEB_API_KEY"
project_id = "your-firebase-project-id"
